# Staging credentials for the integration test suite.
# Copy this file to `.env` (git-ignored) and fill in the values, or export the
# same variables in your environment (real environment variables win over `.env`).
PINGEN2_CLIENT_ID=
PINGEN2_CLIENT_SECRET=
PINGEN2_ORGANIZATION_ID=
PINGEN2_ORGANIZATION_NAME=
# Integration tests must never run against production; keep this on `true`.
PINGEN2_USE_STAGING=true
